PORT=3001
APP_URL=http://localhost:3000
# Comma-separated browser frontend origins allowed by CORS (no paths).
CORS_ORIGINS=http://localhost:3000
SESSION_IDLE_TIMEOUT_MINUTES=15

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veronova_db
DB_USERNAME=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Horse-race data uses DB_DATABASE, the same schema as the rest of the app.
HORSE_JWT_SECRET=
# If HORSE_JWT_SECRET is omitted, JWT_SECRET is used.
RESULTS_API_URL=https://root.usawin.vip/api/trx/results_by_periodno
AVIATOR_RESULT_API_URL=https://root.veronova.co.in/Aviator/
# Defaults to ${APP_URL}/api/cron_news/ when unset; set this only when the timer must call another host.
# WINGO_TIMER_API_URL=https://your-host.example/api/cron_news/
WINGO_RESULT_API_URL=https://root.usawin.vip/api/trx/results_by_periodno
TRX_RESULT_FEED_URL=https://vitalityherbal.life/api/v1/trx-auto-genrated-result
TRX_BLOCK_HASH_URL=https://api.gamebridge.co.in/seller/v1/get-block-hash
TRX_MANAGER_KEY=

# Jili provider API (needed for /api/jilligame)
JILI_SECRET_ID=
JILI_SECRET_KEY=
JILI_TOKEN=
